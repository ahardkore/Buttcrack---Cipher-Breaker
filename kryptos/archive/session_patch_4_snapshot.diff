++    },
++    {
++        "id": "K2",
++        "title": "K2 — The Earth's Magnetic Field",
++        "mechanism": "Quagmire III over the Kryptos alphabet",
++        "key": "ABSCISSA",
++        "verify": "quagmire3",
++        "notes": "Ends in coordinates near Langley and the phrase WHO KNOWS THE EXACT "
