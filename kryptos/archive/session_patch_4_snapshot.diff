++            block = stream[start : start + period]
++            triples = [divmod(pos.get(c, 0), 9) for c in block]
++            layers = [t[0] for t in triples]
++            rows = [divmod(t[1], 3)[0] for t in triples]
++            cols = [t[1] % 3 for t in triples]
++            digits = layers + rows + cols
