+            f'    <h3>{FAMILY_TITLES.get(family, family)}</h3>\n'
+            f'    <p>{FAMILY_BLURBS.get(family, "")}</p>\n'
+            f'    <ul class="cipher-index">\n' + "\n".join(items) + "\n    </ul>"
+        )
+    return "\n".join(out)
