++        return prepare_playfair(text)
++
++    @staticmethod
++    def _pairs(stream: str) -> list[tuple[str, str]]:
++        if len(stream) % 2:
++            stream += "X"
++        return [(stream[i], stream[i + 1]) for i in range(0, len(stream), 2)]
