++        keyspace=None,
++        deterministic=False,
++        min_length=60,
++        cost=BRUTAL,
++        alphabet=A25,
++        aliases=("foursquare", "four_square_cipher"),
++        description="Digraph substitution across two keyed 5x5 grids. No padding and no reversible pairs, unlike Playfair.",
++        example_key={"top": "EXAMPLE", "bottom": "KEYWORD"},
