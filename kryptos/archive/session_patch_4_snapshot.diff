++        total += elapsed
++        got, want = squash(report.plaintext)[:60], squash(plaintext)[:60]
++        ok = got == want
++        passed += ok
++        print(
++            f"{'PASS' if ok else 'FAIL'} {label:24} {elapsed:5.1f}s "
++            f"conf={report.confidence:.2f} {report.path}"
++        )
