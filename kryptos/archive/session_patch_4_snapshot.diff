++    @staticmethod
++    def _unflatten(flat: Sequence[int], periods: Sequence[int]) -> list[list[int]]:
++        wheels, cursor = [], 0
++        for period in periods:
++            wheels.append(list(flat[cursor : cursor + period]))
++            cursor += period
++        return wheels
