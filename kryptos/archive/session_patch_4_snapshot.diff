++
++
++def enc(name: str, text: str, *key) -> str:
++    """Encrypt with a cipher, or encode with a layer."""
++    cipher = get(name)
++    if key:
++        return cipher.encrypt(text, *key)
++    return cipher.encode(text) if hasattr(cipher, "encode") else cipher.encrypt(text)
++
++
