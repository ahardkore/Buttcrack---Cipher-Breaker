++        print(f"        payment link : {link}")
++        print(f"        redirect to  : {delivery_url(cfg, product['sku'])}")
++    tip = cfg["stripe"].get("tip_jar_url") or "— not set —"
++    print(f"\n  tip jar: {tip}")
++
++
