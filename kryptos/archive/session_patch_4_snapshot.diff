++        ciphertext = cipher._apply(plaintext, KRYPTOS_ALPHABET, wheels, +1)
++        subspace = cipher._crib_subspace(
++            ciphertext, KRYPTOS_ALPHABET, [4, 5, 6, 7], plaintext[:12], 0
++        )
