++def _facts_table(info) -> str:
++    keyspace = "unbounded" if info.keyspace is None else f"{info.keyspace:,}"
++    cost = {1.0: "cheap", 3.0: "moderate", 10.0: "expensive", 30.0: "brutal"}.get(
++        info.cost, str(info.cost)
++    )
++    rows = [
++        ("Family", FAMILY_TITLES.get(info.family.value, info.family.value)),
++        ("Key", info.key_type),
++        ("Keyspace", keyspace),
++        ("Search cost", cost),
++        ("Minimum text", f"{info.min_length} characters"),
++    ]
++    if info.aliases:
++        rows.append(("Also known as", ", ".join(info.aliases)))
++    body = "".join(f"<tr><th>{k}</th><td>{v}</td></tr>" for k, v in rows)
++    return f'<table class="facts"><tbody>{body}</tbody></table>'
