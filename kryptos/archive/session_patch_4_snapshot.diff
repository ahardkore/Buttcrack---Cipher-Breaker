++    <p class="note">These figures come from the solver's cipher registry when this page is
++    built, so they describe the implementation you can run above rather than an idealised
++    version of the cipher.</p>
++
++    <h2>Related</h2>
++    <p>{related or 'See the field guide.'}</p>
++    <p>Back to the <a href="cipher-wiki.html">cipher wiki index</a>, or read the
++    <a href="history-of-codebreaking.html">history of codebreaking</a>.</p>"""
++
++        specs.append({
++            "slug": slug,
++            "title": f"{info.title} — How It Works and How It Is Broken",
++            "desc": (f"{info.title}: {info.description} How to recognise it, "
++                     f"a worked example, and the attack that breaks it."),
++            "h1": info.title,
++            "tagline": notes.get("how", info.description)[:150],
++            "preset": "caesar",
