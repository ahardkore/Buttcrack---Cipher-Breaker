++                    stream, alphabet, periods, ctx, rng, wheels=trial, sweeps=90
++                )
++                if kicked_fit > best[1]:
++                    best = ([list(w) for w in kicked], kicked_fit)
++                    if best[1] > SOLVED_FITNESS:
++                        return best
