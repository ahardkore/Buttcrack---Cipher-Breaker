++        name="trifid",
++        title="Trifid",
++        family=Family.POLYGRAPHIC,
++        key_type="keyword + period",
++        keyspace=None,
++        deterministic=False,
++        min_length=90,
++        cost=BRUTAL,
++        alphabet=A27,
++        aliases=("trifid_cipher", "delastelle"),
++        description="Three coordinates per letter in a 3x3x3 cube, recombined within a period. Experimental solver.",
