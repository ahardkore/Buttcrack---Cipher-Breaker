++                    trial = list(current)
++                    trial[i], trial[j] = trial[j], trial[i]
++                    neighbours.append(trial)
++                for i in range(width):
++                    for rank in range(max(current) + 2):
++                        if rank == current[i]:
++                            continue
++                        trial = list(current)
++                        trial[i] = rank
++                        neighbours.append(trial)
++                for trial in neighbours:
