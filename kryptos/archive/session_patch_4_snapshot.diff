++                plain = self._apply(stream, decryption)
++                results.append(
++                    ctx.candidate(
++                        self.name,
++                        plain,
++                        {"matrix": encryption, "keyword": self.key_word(encryption)},
++                        steps=ctx.steps,
++                        block_size=size,
