++        body = self._body(text)
++        if not body:
++            return False
++        # Each line declares its own decoded length in the first character.
++        for line in body:
++            declared = (ord(line[0]) - 32) & 0x3F
++            if not 0 < declared <= 45:
++                return False
++        return True
