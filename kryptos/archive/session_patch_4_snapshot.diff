++        # The notes are written in plain ASCII for readability in the source;
++        # the site's typography uses real dashes.
++        notes = {k: v.replace(" -- ", " — ") for k, v in NOTES.get(info.name, {}).items()}
++        slug = f"{info.name.replace('_', '-')}-cipher-wiki.html"
++        siblings = [
++            c for c in by_family[info.family.value]
++            if c.info.name != info.name
++        ][:6]
++        related = " · ".join(
++            f'<a href="{c.info.name.replace("_", "-")}-cipher-wiki.html">{c.info.title}</a>'
++            if c.info.name not in HAND_WRITTEN
++            else f'<a href="{c.info.name}-cipher-wiki.html">{c.info.title}</a>'
++            for c in siblings
++        )
++        example = _example(info.name)
++        if example:
++            plain_shown, cipher_text, key = example
++            key_line = f"<p>Key: <code>{key}</code></p>" if key else "<p>No key.</p>"
++            example_html = f"""    <h2>A worked example</h2>
++    <p>Plaintext:</p>
++    <pre><code>{plain_shown}</code></pre>
++    {key_line}
++    <p>Ciphertext:</p>
++    <pre><code>{cipher_text}</code></pre>
++    <p class="note">This example is generated by running the cipher when the page is built,
++    and the round trip is checked, so it always matches what the solver does.</p>
++"""
++        else:
++            example_html = ""
++
++        body = f"""    <h2>How it works</h2>
++    <p>{notes.get('how', info.description)}</p>
++    <p>{info.description}</p>
++
++{example_html}
++    <h2>How it is broken</h2>
++    <p>{notes.get('breaking', 'See the field guide for the general approach to this family.')}</p>
++
++    <h2>History and context</h2>
++    <p>{notes.get('history', 'A member of the ' + FAMILY_TITLES.get(info.family.value, '') + ' family.')}</p>
++
++    <h2>At a glance</h2>
